{
  "schema_version": 1,
  "status": "design_only",
  "model_config": "configs/architecture/base-316m.json",
  "tokenizer_config": "configs/tokenizer/korean-morph-bpe-32k.json",
  "objective": "causal_next_token_prediction",
  "optimizer": {
    "name": "adamw",
    "learning_rate": 0.0003,
    "betas": [
      0.9,
      0.95
    ],
    "epsilon": 1e-8,
    "weight_decay": 0.1,
    "no_weight_decay": [
      "embedding_and_tied_lm_head",
      "normalization_scales"
    ],
    "deduplicate_shared_parameters": true
  },
  "scheduler": {
    "type": "linear_warmup_then_cosine",
    "warmup_ratio": 0.01,
    "min_lr_ratio": 0.1,
    "step_unit": "optimizer_update"
  },
  "gradient_clip_global_norm": 1,
  "precision": {
    "autocast": "bfloat16",
    "loss": "float32",
    "optimizer_state": "float32"
  },
  "z_loss": {
    "coefficient": 0,
    "ablation_coefficients": [
      0,
      0.00001,
      0.0001
    ],
    "reduction": "mean_over_valid_shifted_targets",
    "compute_dtype": "float32"
  },
  "batch": {
    "micro_batch_size": null,
    "gradient_accumulation_steps": null,
    "world_size": null,
    "loss_normalization": "valid_target_tokens_across_accumulation_and_ranks"
  },
  "budget": {
    "total_training_tokens": null
  },
  "data": {
    "manifest": null,
    "tokenizer_train_split_only": true,
    "document_isolated_packing": true
  },
  "evaluation": {
    "metrics": [
      "cross_entropy",
      "bits_per_byte",
      "korean_task_scores",
      "generation_repetition",
      "eos_behavior",
      "peak_memory",
      "tokens_per_second"
    ],
    "compare_token_perplexity_only_with_identical_tokenizer": true
  },
  "checkpoint": {
    "save_optimizer": true,
    "save_scheduler": true,
    "save_rng": true,
    "save_data_cursor": true,
    "save_tokenizer_hash": true
  }
}
